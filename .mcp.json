{
  "mcpServers": {
    "graphify": {
      "command": "bash",
      "args": [
        "scripts/graphify-mcp-serve.sh"
      ]
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "neon": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@latest",
        "https://mcp.neon.tech/mcp"
      ]
    }
  }
}
