<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NicaRunner.Domain\NicaRunner.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.*" />
    <!-- Paquete core (agnóstico de proveedor): AliasAssigner necesita DbUpdateException
         para discriminar la colisión de Username, sin que Application dependa de
         Sqlite/Postgres — esos paquetes de proveedor concreto siguen siendo exclusivos
         de Infrastructure. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
